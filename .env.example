# Relevo — variables de entorno. Copia este archivo a .env.
# Los valores de ejemplo SOLO sirven para desarrollo local: cámbialos en producción.

# Clave para la API de administración y el panel (mínimo 20 caracteres)
ADMIN_API_KEY=cambia-esta-clave-de-desarrollo-123

# Clave AES-256 para cifrar los secretos en la base de datos (32 bytes en base64)
# Genera una con: openssl rand -base64 32
CLAVE_CIFRADO=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# URL pública donde los proveedores envían los webhooks (se usa para mostrar la URL de entrada)
URL_PUBLICA=http://localhost:3000

# Orígenes del panel que pueden llamar a la API (separados por coma)
ORIGENES_PANEL=http://localhost:4200

# Solo desarrollo: permite destinos http:// (en producción deben ser https)
PERMITIR_HTTP=true

# Fuera de Docker también necesitas:
# DATABASE_URL=postgresql://relevo:relevo@localhost:5432/relevo
